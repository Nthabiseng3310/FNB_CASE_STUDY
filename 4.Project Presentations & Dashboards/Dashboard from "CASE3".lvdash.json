      "displayName": "FNB Data",
      "queryLines": [
        "SELECT\n",
        "  Date,\n",
        "  DATE_TRUNC('month', Date) AS Month,\n",
        "  DATE_FORMAT(Date, 'MMM yyyy') AS Month_Year,\n",
        "  Month_name,\n",
        "  Year,\n",
        "  Day_Name,\n",
        "  Quantity_Sold,\n",
        "  Sales_Rounded,\n",
        "  Cost_Of_Sales_Rounded,\n",

        "  Gross_Profit_Percentage,\n",
        "  Price_Per_Unit,\n",
        "  Unit_Cost,\n",
        "  Gross_Profit_Pct_Per_Unit,\n",
        "  Period_Type\n",
        "FROM\n",
        "  `workspace`.`default`.`fnb_final_daily`"
      ]
    }
